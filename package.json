{
  "name": "ai-saas-audit-agent",
  "version": "0.1.0",
  "description": "Local-first audit CLI for AI SaaS security, privacy, scalability, payments, and production readiness.",
  "type": "module",
  "bin": {
    "saas-audit": "./bin/saas-audit.js"
  },
  "scripts": {
    "dev:web": "node ./web/server.js",
    "scan": "node ./bin/saas-audit.js scan .",
    "test": "node --test test/*.test.js",
    "fixture:scan": "node ./bin/saas-audit.js scan ./test/fixtures/vulnerable-app --out-dir ./test-output"
  },
  "keywords": [
    "security",
    "audit",
    "saas",
    "owasp",
    "privacy",
    "openai",
    "stripe"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@revenuecat/purchases-js": "^1.41.1"
  }
}
