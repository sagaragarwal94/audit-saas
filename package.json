{
  "name": "auditsaas",
  "version": "0.1.0",
  "description": "Local CLI for SaaS security, privacy, AI, payments, and production readiness audits.",
  "type": "module",
  "bin": {
    "saas-audit": "./bin/saas-audit.js"
  },
  "files": [
    "bin/",
    "src/",
    "rules/",
    ".claude/skills/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "scan": "node ./bin/saas-audit.js scan .",
    "test": "node --test test/*.test.js",
    "fixture:scan": "node ./bin/saas-audit.js scan ./test/fixtures/vulnerable-app --out-dir ./test-output",
    "build:rules-page": "node ./scripts/generate-rules-page.mjs",
    "pack": "npm test && mkdir -p dist && npm pack --pack-destination ./dist"
  },
  "keywords": [
    "security",
    "audit",
    "saas",
    "owasp",
    "privacy",
    "openai",
    "stripe"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  }
}
