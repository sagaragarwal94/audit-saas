{
  "name": "auditsaas",
  "version": "0.2.0",
  "description": "Local CLI for SaaS security, privacy, AI, payments, and production readiness audits.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagaragarwal94/audit-saas.git"
  },
  "homepage": "https://auditsaas.org",
  "bugs": {
    "url": "https://github.com/sagaragarwal94/audit-saas/issues"
  },
  "bin": {
    "saas-audit": "./bin/saas-audit.js",
    "auditsaas": "./bin/saas-audit.js"
  },
  "files": [
    "bin/",
    "src/",
    "rules/",
    ".claude/skills/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "scan": "node ./bin/saas-audit.js scan . --no-history",
    "self-scan": "node ./bin/saas-audit.js scan . --no-history --no-ai-review --out-dir ./audit-output",
    "test": "node --test test/*.test.js",
    "fixture:scan": "node ./bin/saas-audit.js scan ./test/fixtures/vulnerable-app --out-dir ./test-output --no-history",
    "build:rules-page": "node ./scripts/generate-rules-page.mjs",
    "pack": "npm test && mkdir -p dist && npm pack --pack-destination ./dist"
  },
  "keywords": [
    "security",
    "audit",
    "saas",
    "owasp",
    "privacy",
    "sarif",
    "security-scanner",
    "nextjs",
    "openai",
    "stripe"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  }
}
