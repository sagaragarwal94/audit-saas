APP_BASE_URL=http://127.0.0.1:4000
HOST=127.0.0.1
PORT=4000
SESSION_SECRET=replace-with-a-long-random-secret
AUTH0_SECRET=replace-with-auth0-generated-secret

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH0_AUDIENCE=

REVENUECAT_API_KEY=replace-with-revenuecat-web-app-public-key
REVENUECAT_ENTITLEMENT_ID=pro
REVENUECAT_OFFERING_ID=
REVENUECAT_STARTER_PACKAGE_ID=
REVENUECAT_PRO_PACKAGE_ID=
REVENUECAT_WEBHOOK_SECRET=replace-with-revenuecat-webhook-secret

CLI_DOWNLOAD_URL=

# Optional local CLI AI reviewer. These are read by the CLI on the user's machine,
# not by the Gravel web backend.
GRAVEL_LLM_API_KEY=
GRAVEL_LLM_MODEL=
GRAVEL_LLM_BASE_URL=https://api.openai.com/v1
GRAVEL_AI_REVIEW=true
